# Required SQLite database file as a file: URL (ADR 0029). The container path is backed by the
# `data` volume; a development checkout uses file:./tmp/dev.db. The -wal and -shm siblings are
# created beside the file, so keep it on a local disk, never on a network share or a synced folder.
DATABASE_URL=file:/var/lib/enan/data/enan.db
# Required random session secret, at least 32 characters. Never commit the populated .env.
SESSION_SECRET=
# Canonical browser origin. Production refuses to start unless this is https, except on loopback;
# the session cookie's Secure flag follows it. Use an HTTPS reverse proxy in production.
APP_URL=http://localhost:3000
# Comma-separated proxy addresses or CIDRs, for example "10.0.0.0/8, fd00::/8". Startup refuses a
# malformed list. Empty means forwarded client-address headers are untrusted, which disables
# per-address login and recovery throttling; per-email login throttling still applies.
TRUSTED_PROXY_CIDRS=
# Optional fallback. Prefer saving your OpenRouter key in Admin → AI.
# Saved keys override this environment value; keep SESSION_SECRET stable to decrypt them.
OPENROUTER_API_KEY=
# Optional outgoing mail server (ADMIN-B60, ADR 0053). Prefer saving it in Admin → Email, which
# overrides these. Port 587 must offer STARTTLS; 465 is TLS from the start; mail is never sent in
# clear text. For Google Workspace or Gmail: smtp.gmail.com, 587, your address, and an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Optional Google sign-in client (ADMIN-B65). Prefer saving it in Admin → Sign-in, which overrides
# these. Register <APP_URL>/api/auth/callback/google as its redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Disable locally while developing; enabled by default for normal operation.
AI_RATE_LIMIT_ENABLED=true
# Container paths backed by named volumes.
FILES_DIR=/var/lib/enan/files
BACKUP_DIR=/var/lib/enan/backups
# Optional: the install's own Arabic faces (ADMIN-B51, ADR 0049): text-400.woff2, display-700.woff2 ...
# Empty or missing means Noto Sans Arabic.
FONTS_DIR=/var/lib/enan/fonts
# Where the app reads the updater's status and leaves its commands (ADMIN-B57, ADR 0051); the
# compose file mounts the updater's volumes here. Without the updater the page says it is not running.
UPDATER_STATUS_DIR=/var/lib/enan-updater/status
UPDATER_COMMANDS_DIR=/var/lib/enan-updater/commands
# Storage quota in GiB and maximum upload size in MiB.
FILES_QUOTA_GB=20
MAX_UPLOAD_MB=20
# Largest wallpaper image an administrator may upload, in MB (at most 10).
WALLPAPER_MAX_MB=10
# In-process runner configuration.
JOBS_ENABLED=true
JOBS_CONCURRENCY=4
JOBS_DRAIN_SECONDS=25
# Optional single-use administrator recovery token, at least 32 characters when set; startup
# refuses a shorter one. Generate with: openssl rand -hex 32. Set it, restart, use it, then unset.
RECOVERY_TOKEN=
# Which published image `docker compose pull` fetches (ADMIN-B54): latest (the newest release),
# edge (the newest main that passed every check), or a year, month or release such as 2026,
# 2026.10 or 2026.10.1 (ADR 0056).
ENAN_TAG=latest
# Updates (ADMIN-B56, ADMIN-B67, ADR 0057). The updater announces new releases on Administration →
# Updates; installing, automatic or not, is chosen there. ENAN_UPDATER_REPLICAS=0 runs no updater
# (it holds the Docker socket). The channel defaults to ENAN_TAG. ENAN_UPDATE_TZ is the time zone of
# the install window set on the page. The webhook receives a JSON POST for every announcement,
# install, failure and rollback (Slack accepts it as is). The updater image follows the app's
# channel (ENAN_CHANNEL, else ENAN_TAG) unless ENAN_UPDATER_TAG names another (ADR 0060).
ENAN_UPDATER_TAG=
ENAN_UPDATER_REPLICAS=1
ENAN_CHANNEL=
ENAN_UPDATE_INTERVAL=24h
ENAN_UPDATE_TZ=UTC
ENAN_ALERT_WEBHOOK=
# Structured logging level: trace, debug, info, warn, error, fatal.
LOG_LEVEL=info
# Development/test only: a separate disposable SQLite file whose basename ends in _test.db, never
# the live database, for example file:./tmp/enan_test.db.
DATABASE_URL_TEST=
