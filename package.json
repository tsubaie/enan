{
  "name": "enan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.14.0 <23",
    "pnpm": "10.30.3"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build && tsx scripts/build/assemble-standalone.ts",
    "start": "node .next/standalone/server.js",
    "lint": "oxlint --max-warnings=0 .",
    "typecheck": "tsc --noEmit",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --env-file-if-exists=.env.test node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file-if-exists=.env.test node_modules/vitest/vitest.mjs",
    "test:e2e": "playwright test",
    "test:audits": "node --env-file-if-exists=.env.test node_modules/vitest/vitest.mjs run scripts/audit/tests tests",
    "db:migrate": "node --conditions=react-server --import tsx scripts/db/migrate.ts",
    "db:reset": "node --conditions=react-server --import tsx scripts/db/reset.ts",
    "db:seed": "node --conditions=react-server --import tsx scripts/db/seed.ts",
    "backup:create": "node --conditions=react-server --import tsx scripts/backup/create.ts",
    "backup:restore": "node --conditions=react-server --import tsx scripts/backup/restore.ts",
    "audit:all": "pnpm audit:static && pnpm audit:data && pnpm audit:browser",
    "audit:static": "pnpm lint && pnpm typecheck && pnpm depcruise && pnpm audit:structure && pnpm audit:i18n && pnpm audit:portability && pnpm audit:docs && pnpm audit:tests && pnpm audit:deps && pnpm audit:secrets && pnpm audit:dupes && pnpm audit:migrations",
    "audit:data": "pnpm audit:schema && pnpm test",
    "audit:browser": "pnpm build && pnpm audit:bundle && pnpm test:e2e && pnpm audit:openapi && pnpm audit:a11y && pnpm audit:perf",
    "audit:structure": "tsx scripts/audit/structure.ts",
    "audit:bundle": "tsx scripts/audit/bundle.ts",
    "audit:i18n": "tsx scripts/audit/i18n.ts",
    "audit:portability": "tsx scripts/audit/portability.ts",
    "audit:schema": "node --conditions=react-server --import tsx scripts/audit/schema.ts",
    "audit:docs": "tsx scripts/audit/docs.ts",
    "audit:tests": "tsx scripts/audit/tests.ts",
    "audit:deps": "tsx scripts/audit/deps.ts",
    "audit:openapi": "node --conditions=react-server --import tsx scripts/audit/openapi.ts",
    "audit:a11y": "tsx scripts/audit/a11y.ts",
    "audit:perf": "node --conditions=react-server --import tsx scripts/audit/perf.ts",
    "audit:dupes": "tsx scripts/audit/dupes.ts",
    "audit:secrets": "tsx scripts/audit/secrets.ts",
    "audit:migrations": "tsx scripts/audit/migrations.ts",
    "db:e2e-account": "node --conditions=react-server --import tsx scripts/db/e2e-account.ts",
    "db:e2e-reset": "node --conditions=react-server --import tsx scripts/db/e2e-reset.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@base-ui/react": "1.9.0",
    "@hookform/resolvers": "6.0.1",
    "@libsql/client": "0.18.0",
    "@tanstack/react-query": "5.105.0",
    "argon2": "0.45.1",
    "better-auth": "1.7.14",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cron-parser": "5.10.2",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.62.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "nodemailer": "10.2.1",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-markdown": "10.1.0",
    "recharts": "3.10.1",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "tar": "7.5.22",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@formatjs/icu-messageformat-parser": "3.5.22",
    "@playwright/test": "1.64.1",
    "@swc/core": "1.16.20",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.7.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "jscpd": "5.4.2",
    "jsdom": "30.1.3",
    "knip": "6.43.0",
    "oxlint": "1.90.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@5": "5.0.12",
      "fast-uri@3": "3.1.9",
      "sharp": "0.35.5",
      "source-map-js": "1.2.2",
      "undici@8": "8.12.2"
    }
  }
}
